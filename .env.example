# Copy this file to .env.local and fill in the values.
# .env.local is the only env file the app loads, and it is not tracked by Git.

# Clerk auth — get keys from https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Contact form recipient (submissions go through formsubmit.co)
FORMSUBMIT_EMAIL=

# Arcjet bot-protection / WAF key (format ajkey_…). Unset = bypass in dev.
ARCJET_KEY=

# Sentry browser DSN.
# NOTE: NEXT_PUBLIC_SENTRY_DISABLED=1 currently breaks page rendering (every
# route 500s with a JSON parse error). Leave it empty until that is fixed.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=

# Logging level: error | info | debug | warning | trace | fatal
NEXT_PUBLIC_LOGGING_LEVEL=debug

NEXT_TELEMETRY_DISABLED=1
