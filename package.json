{
  "name": "nextjs-latest-starter",
  "author": "latest",
  "type": "module",
  "scripts": {
    "dev:spotlight": "pnpm exec spotlight",
    "dev": "next dev",
    "dev:debug": "cross-env NEXT_PUBLIC_SPOTLIGHT=1 run-p dev:next dev:spotlight",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true pnpm run build",
    "clean": "rimraf .next out",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "run-s lint:oxlint format:check",
    "lint:fix": "run-s lint:oxlint:fix format",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint --fix .",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:fallow": "pnpm dlx fallow@latest",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl -i 'RootLayout.*' 'BaseTemplate.*' 'Navigation.about' 'Navigation.contact' 'Index.*' 'About.*' 'Contact.meta_title' 'Contact.meta_description' 'SignIn.*' 'SignUp.*' 'NotFound.heading' 'meta_title' 'meta_description'",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "commit": "commit",
    "optimize-images": "node scripts/optimize-images.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:next": "next dev"
  },
  "dependencies": {
    "@arcjet/next": "1.11.0",
    "@base-ui/react": "1.7.0",
    "@clerk/localizations": "4.15.8",
    "@clerk/nextjs": "7.8.3",
    "@hookform/resolvers": "5.9.1",
    "@logtape/logtape": "2.3.2",
    "@sentry/nextjs": "10.73.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-devtools": "5.102.8",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.0",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/prompt-cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@next/bundle-analyzer": "16.3.4",
    "@next/playwright": "16.3.4",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@spotlightjs/spotlight": "4.11.8",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "happy-dom": "20.12.0",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "schema-dts": "2.0.0",
    "secretlint": "13.0.5",
    "semantic-release": "25.0.9",
    "shadcn": "4.19.1",
    "sharp": "0.35.4",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.4.0"
  },
  "packageManager": "pnpm@11.4.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
