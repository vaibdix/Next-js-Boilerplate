{
  "name": "nextjs-latest-starter",
  "author": "latest",
  "type": "module",
  "scripts": {
    "dev:spotlight": "pnpm exec spotlight",
    "dev": "next dev",
    "dev:debug": "cross-env NEXT_PUBLIC_SPOTLIGHT=1 run-p dev:next dev:spotlight",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true pnpm run build",
    "clean": "rimraf .next out",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "run-s lint:oxlint format:check",
    "lint:fix": "run-s lint:oxlint:fix format",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint --fix .",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:fallow": "pnpm dlx fallow@latest",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl -i 'RootLayout.*' 'BaseTemplate.*' 'Navigation.about' 'Navigation.contact' 'Index.*' 'About.*' 'Contact.meta_title' 'Contact.meta_description' 'SignIn.*' 'SignUp.*' 'NotFound.heading' 'meta_title' 'meta_description'",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "commit": "commit",
    "optimize-images": "node scripts/optimize-images.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:next": "next dev"
  },
  "dependencies": {
    "@arcjet/next": "1.9.1",
    "@base-ui/react": "1.6.0",
    "@clerk/localizations": "4.13.8",
    "@clerk/nextjs": "7.6.2",
    "@hookform/resolvers": "5.5.7",
    "@logtape/logtape": "2.2.4",
    "@sentry/nextjs": "10.68.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "lucide-react": "1.27.0",
    "next": "16.3.0",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "sonner": "2.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/prompt-cli": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@spotlightjs/spotlight": "4.11.8",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "checkly": "8.19.0",
    "cross-env": "10.1.0",
    "happy-dom": "20.11.1",
    "knip": "6.31.0",
    "lefthook": "2.1.10",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "schema-dts": "2.0.0",
    "secretlint": "13.0.4",
    "semantic-release": "25.0.8",
    "shadcn": "4.16.0",
    "sharp": "0.35.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.4.0"
  },
  "packageManager": "pnpm@11.4.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
