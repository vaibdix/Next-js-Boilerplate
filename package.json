{
  "name": "nextjs-webalar-starter",
  "author": "Webalar (https://github.com/webalar-developers)",
  "type": "module",
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsgo --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "commit": "commit",
    "optimize-images": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "@arcjet/next": "^1.4.0",
    "@base-ui/react": "^1.5.0",
    "@clerk/localizations": "^4.5.2",
    "@clerk/nextjs": "^7.2.3",
    "@hookform/resolvers": "^5.4.0",
    "@logtape/logtape": "^2.1.1",
    "@sentry/nextjs": "^10.49.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "nuqs": "^2.8.9",
    "react": "^19.2.5",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/prompt-cli": "^20.5.0",
    "@lingual/i18n-check": "^0.9.3",
    "@next/bundle-analyzer": "^16.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@spotlightjs/spotlight": "^4.11.3",
    "@swc/helpers": "^0.5.21",
    "@tailwindcss/postcss": "^4.2.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "beta",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^7.11.0",
    "cross-env": "^10.1.0",
    "knip": "^6.6.0",
    "lefthook": "^2.1.6",
    "npm-run-all2": "^7.0.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "^6.1.3",
    "schema-dts": "^2.0.0",
    "secretlint": "^13.0.2",
    "semantic-release": "^25.0.3",
    "shadcn": "^4.4.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.3",
    "typescript": "^6.0.0",
    "ultracite": "^7.7.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.4.0"
  },
  "packageManager": "pnpm@11.4.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
