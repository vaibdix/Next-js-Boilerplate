{
  "compilerOptions": {
    // ======================================================================
    // Language & Environment
    // Defines JavaScript version and runtime environment
    // ======================================================================
    "target": "ES2025",
    "module": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "moduleResolution": "bundler",
    // ======================================================================
    // Module System (TS 6.0+)
    // Enforces modern module patterns aligned with TS 6.0 defaults
    // ======================================================================
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // ======================================================================
    // Type Safety - Foundation
    // Core type checking settings for a robust codebase
    // ======================================================================
    "strict": true,
    // ======================================================================
    // Type Safety - Advanced
    // Additional checks beyond strict for higher code quality
    // ======================================================================
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noImplicitOverride": true,
    // ======================================================================
    // Interoperability
    // Settings for working with different file types and modules
    // ======================================================================
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // ======================================================================
    // Build & Performance
    // Settings that affect compilation output and build performance
    // ======================================================================
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // ======================================================================
    // Project Structure
    // Configure import paths and module resolution
    // ======================================================================
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/public/*": [
        "./public/*"
      ]
    },
    // ======================================================================
    // Next.js Project Configuration
    // Controls settings specific to Next.js framework
    // ======================================================================
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
