{
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "search.exclude": {
    "package-lock.json": true
  },

  // TypeScript
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    "next/router",
    "lucide-react",
    "chai",
    "zod/v3",
    "@sentry/nextjs",
    "postcss"
  ],

  "testing.automaticallyOpenTestResults": "neverOpen",

  // I18n
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.keystyle": "nested",

  // Oxc
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSaveMode": "file", // Tell oxfmt to format the whole file, not only the modified lines
  "oxc.typeAware": true, // Enable type-aware linting

  // Auto fix on save
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.fixAll.stylelint": "explicit"
  },

  // Per-language formatters (mirrors Pierre)
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptjsx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[mdx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  // Stylelint
  "stylelint.validate": ["css", "postcss"],
  "css.validate": false,

  // JSON Schema
  "json.schemaDownload.trustedDomains": {
    "https://ui.shadcn.com": true
  },
  "js/ts.experimental.useTsgo": true
}
