{
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "search.exclude": {
    "package-lock.json": true
  },

  // TypeScript
  "js/ts.tsdk.path": "node_modules/typescript/lib", // Use the workspace version of TypeScript
  "js/ts.tsdk.promptToUseWorkspaceVersion": true, // Use the Go-based TypeScript compiler (TS 7 native preview)
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // useRouter should be imported from `libs/I18nNavigation` instead of `next/router`
    "next/router",
    // give priority for Link to next/link instead of lucide-react
    "lucide-react",
    // Not used in the project and conflicts with `use()` from React
    "chai",
    // Use Zod v4 instead of v3
    "zod/v3",
    // Sentry is imported with `import *`
    "@sentry/nextjs",
    // Use Input from Shadcn UI instead of Input from Postcss
    "postcss"
  ],

  // Vitest
  "testing.automaticallyOpenTestResults": "neverOpen", // Don't open the test results automatically

  // I18n
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.keystyle": "nested",

  // Oxc
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSaveMode": "file", // Tell oxfmt to format the whole file, not only the modified lines
  "oxc.typeAware": true, // Enable type-aware linting

  // Auto fix on save
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.fixAll.stylelint": "explicit"
  },

  // Per-language formatters (mirrors Pierre)
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptjsx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[mdx]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  // Stylelint
  "stylelint.validate": ["css", "postcss"],
  "css.validate": false,

  // JSON Schema
  "json.schemaDownload.trustedDomains": {
    "https://ui.shadcn.com": true
  },
  "js/ts.experimental.useTsgo": true,
  "typescript.native-preview.tsdk": "${workspaceFolder}/node_modules/@typescript/native-preview"
}
