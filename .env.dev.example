# Template for `.env.local` when running the dev compose stack.
# Copy this file:  cp .env.dev.example .env.local
# Then fill in the required values below.

# ---- Required ----
# Clerk auth — get keys from https://dashboard.clerk.com/last-active?path=api-keys
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---- Optional ----
# Contact form recipient (form submission goes through formsubmit.co)
FORMSUBMIT_EMAIL=

# Sentry browser DSN. Leave NEXT_PUBLIC_SENTRY_DISABLED=1 in dev to skip the
# Sentry wrapper entirely — meaningfully faster server renders.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DISABLED=1

# Arcjet bot-protection / WAF key (format ajkey_…). Unset = bypass in dev.
ARCJET_KEY=
